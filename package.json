{
  "name": "@tumy/mobile-chat-grpc",
  "version": "1.0.6",
  "description": "gRPC in MobileChat",
  "scripts": {
    "generate": "mkdir -p ./gen && protoc -I ./proto $(find ./proto -name '*.proto') --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "proto",
    "gen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "dependencies": {
    "@nestjs/microservices": "^12.1.0",
    "rxjs": "^7.8.2",
    "ts-proto": "^2.12.4"
  }
}
